# =============================================================================
# Content Distributor - Configuration
# Copy this file to .env and fill in your credentials
# =============================================================================

# Server
PORT=3000
DRY_RUN=true

# Google Gemini AI (for brand review)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook Graph API
# For multiple pages, use comma-separated values (matching order)
FACEBOOK_PAGE_IDS=page_id_1,page_id_2
FACEBOOK_PAGE_TOKENS=token_for_page_1,token_for_page_2
FACEBOOK_API_VERSION=v21.0

# WordPress REST API
WORDPRESS_URL=https://your-site.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_application_password

# Google Drive
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_shared_folder_id

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_SHEET_NAME=master
